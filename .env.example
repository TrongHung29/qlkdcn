# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG WMS
# ==========================================

# 1. Cấu hình PostgreSQL dùng chung cho 2 shard (khớp docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wms_db

# Cổng host của các node CSDL (Primary, Shard South, Replica dự phòng)
POSTGRES_PORT=5432
POSTGRES_NORTH_PORT=5432
POSTGRES_SOUTH_PORT=5433
POSTGRES_REPLICA_PORT=5434

# Database URLs
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wms_db?schema=public"
DB_REPLICA_URL="postgresql://postgres:postgres@localhost:5434/wms_db?schema=public"

# 2. Cấu hình Backend Server
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_wms_team8_2026

# 3. Cấu hình Client (Frontend CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# 4. KIẾN TRÚC PHÂN TÁN v2 (2 SHARD + SAGA)
# ==========================================
DB_NORTH_URL="postgresql://postgres:postgres@localhost:5432/wms_db?schema=public"
DB_SOUTH_URL="postgresql://postgres:postgres@localhost:5433/wms_db?schema=public"

WAREHOUSE_NORTH_CODE=WH-NORTH-01
WAREHOUSE_NORTH_NAME=Kho Miền Bắc (Hà Nội)
WAREHOUSE_SOUTH_CODE=WH-SOUTH-01
WAREHOUSE_SOUTH_NAME=Kho Miền Nam (TP. HCM)

# RabbitMQ (topic exchange warehouse.saga.events)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SAGA_EXCHANGE=warehouse.saga.events
SAGA_DLX_EXCHANGE=warehouse.saga.dlx
SAGA_INBOUND_QUEUE=warehouse.saga.inbound
SAGA_REPLY_QUEUE=warehouse.saga.reply
SAGA_DLQ=warehouse.saga.dead-letter

# Redis / Redlock (khóa phân tán chặn cùng key ở 2 shard)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
REDLOCK_URLS="redis://localhost:6379"
REDLOCK_ENABLED=true
REDLOCK_REQUIRED=false
REDLOCK_TTL_MS=10000
REDLOCK_RETRIES=3

# CQRS read side: bật đọc từ Hot Standby 5434 cho /api/v2/.../inventory/summary
REPLICA_READS_ENABLED=true
PG_READ_POOL_MAX=10

# Đối soát định kỳ ledger vs tồn (ms)
RECONCILE_INTERVAL_MS=300000

# Outbox relay & reservation expiry
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_MS=1000
RESERVATION_TTL_MINUTES=30
RESERVATION_CLEANUP_MS=60000
SYSTEM_ACTOR_ID=01900000-0000-7000-8000-000000000001
PG_POOL_MAX=20
